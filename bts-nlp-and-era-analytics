========================================================================\n# AUTOMATIC PATH FINDER & UNICODE DECODER (Hata Çözücü Bölüm)\n# ==============================================================================\nfound_file = '/kaggle/input/datasets/learnwithsrishti/bts-data-set-in-csv/lyrics-v6.csv'\n\ntry:\n    # utf-8-sig ve errors='replace' kullanarak bozuk karakterlerin kodu kilitlemesini engelliyoruz\n    df = pd.read_csv(found_file, encoding='utf-8-sig', errors='replace')\n    print(\"SUCCESS: Dataset loaded perfectly with UTF-8-SIG encoding!\")\nexcept:\n    # Eğer yukarıdaki yemezse dünya genelinde metinler için kullanılan latin1 formatını deniyoruz\n    df = pd.read_csv(found_file, encoding='latin1')\n    print(\"SUCCESS: Dataset loaded perfectly with LATIN1 encoding!\")\n\n# Garanti olması için tüm sütun isimlerini küçük harfe çevirelim (Büyük/küçük harf hatasını önler)\ndf.columns = df.columns.str.lower()\n\n# ==============================================================================\n# 1. CHRONOLOGICAL ERA SEGMENTATION\n# ==============================================================================\ndf['album_rd'] = pd.to_datetime(df['album_rd'])\ndf['year'] = df['album_rd'].dt.year\n\ndef track_bts_era(year):\n    if year <= 2015:\n        return 'Early Era (School & Youth)'\n    elif 2016 <= year <= 2018:\n        return 'Golden Era (Wings & Love Yourself)'\n    else:\n        return 'Global Era (Dynamite & Beyond)'\n\ndf['bts_era'] = df['year'].apply(track_bts_era)\n\n# ==============================================================================\n# 2. NLP TEXT COMPLEXITY METRICS\n# ==============================================================================\ndf['lyrics'] = df['lyrics'].fillna('')\ndf['word_count'] = df['lyrics'].apply(lambda x: len(x.split()))\ndf['char_count'] = df['lyrics'].apply(lambda x: len(x))\ndf['avg_word_length'] = df['char_count'] / (df['word_count'] + 1)\n\n# ==============================================================================\n# 3. NEW NLP METRIC: LYRICAL REPETITIVENESS INDEX\n# ==============================================================================\ndef calculate_repetitiveness(text):\n    if not text:\n        return 0.0\n    cleaned_text = re.sub(r'[^\\w\\s]', '', text.lower())\n    words = cleaned_text.split()\n    total_words = len(words)\n    if total_words == 0:\n        return 0.0\n    unique_words = len(set(words))\n    return round(1.0 - (unique_words / total_words), 4) * 100\n\ndf['repetitiveness_index'] = df['lyrics'].apply(calculate_repetitiveness)\n\n# ==============================================================================\n# 4. PROCESS VERIFICATION\n# ==============================================================================\nprint(\"==================================================\")\nprint(\"SUCCESS: Phase 2 Feature Engineering Completed Smoothly!\")\nprint(\"==================================================\")\n\n# Sütun isimlerini küçük harf yaptığımız için burayı güncelledik\nprint(df[['track_title', 'bts_era', 'word_count', 'repetitiveness_index', 'hidden_track']].head(10))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T17:42:45.775584Z","iopub.execute_input":"2026-09-17T17:42:45.775823Z","iopub.status.idle":"2026-09-17T17:42:45.843813Z","shell.execute_reply.started":"2026-09-17T17:42:45.775801Z","shell.execute_reply":"2026-09-17T17:42:45.84282Z"}},"outputs":[{"name":"stdout","text":"SUCCESS: Dataset loaded perfectly with LATIN1 encoding!\n==================================================\nSUCCESS: Phase 2 Feature Engineering Completed Smoothly!\n==================================================\n                           track_title                     bts_era  \\\n0  Intro: 2 Cool 4 Skool (ft. DJ Friz)  Early Era (School & Youth)   \n1             We Are Bulletproof Pt.2   Early Era (School & Youth)   \n2              Skit: Circle Room Talk   Early Era (School & Youth)   \n3                       No More Dream   Early Era (School & Youth)   \n4                            Interlude  Early Era (School & Youth)   \n5               ì¢ìì (I Like It)   Early Era (School & Youth)   \n6            Outro: Circle Room Cypher  Early Era (School & Youth)   \n7             Skit: On The Start Line   Early Era (School & Youth)   \n8                     ê¸¸ (Road/Path)   Early Era (School & Youth)   \n9                    Intro: O!RUL8,2?   Early Era (School & Youth)   \n\n   word_count  repetitiveness_index  hidden_track  \n0          90                 46.67         False  \n1         491                 66.19         False  \n2         487                 60.29         False  \n3         490                 67.89         False  \n4           0                  0.00         False  \n5         514                 64.20         False  \n6         862                 63.69         False  \n7         266                 44.36          True  \n8         586                 58.12          True  \n9         139                 38.13         False  \n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"## Phase 4: Machine Learning Model 1 - \"Hidden Tracks\" Classification\nIn this phase, we build our first predictive machine learning model. The objective is a binary classification task: predicting whether a song is a \"Hidden Track\" (True) or a mainstream song (False) based on its structural metrics (word count, track sequence, and repetitiveness). \n\n### Process:\n1. **Feature Selection (X) & Target Labeling (y)**\n2. **Data Splitting:** 80% Training and 20% Testing sets.\n3. **Model Training:** Deploying a Random Forest Classifier.\n4. **Performance Evaluation:** Utilizing Confusion Matrix and Accuracy metrics.\n","metadata":{}},{"cell_type":"code","source":"# ==============================================================================\n# STEP 1: PREPARING THE INPUT FEATURES (X) AND THE TARGET TARGET (y)\n# ==============================================================================\n# X represents the independent variables (the features our AI will learn from)\n# We choose numerical structural metrics that might distinguish a hidden track.\nX = df[['album_seq', 'word_count', 'char_count', 'avg_word_length', 'repetitiveness_index']]\n\n# y represents the dependent variable (what we want the AI to predict)\n# We convert True/False boolean data into 1 and 0 so the machine can process it.\ny = df['hidden_track'].astype(int)\n\n# ==============================================================================\n# STEP 2: SPLITTING DATA INTO TRAINING AND TESTING SETS\n# ==============================================================================\n# test_size=0.20 means 20% of songs are hidden away for the final exam (Test Set)\n# 80% of songs are given to the AI to study from (Training Set)\n# random_state=42 ensures that the split is exact same every time we run it\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)\n\n# ==============================================================================\n# STEP 3: INITIALIZING AND TRAINING THE RANDOM FOREST CLASSIFIER\n# ==============================================================================\n# n_estimators=100 means our forest will have 100 individual decision trees voting together\nrf_model = RandomForestClassifier(n_estimators=100, random_state=42)\n\n# Training the model using our 80% training data\nrf_model.fit(X_train, y_train)\n\n# ==============================================================================\n# STEP 4: MODEL EVALUATION & TESTING\n# ==============================================================================\n# The AI takes its final exam here by predicting the 20% unseen test data\ny_pred = rf_model.predict(X_test)\n\n# Calculate the overall success score\naccuracy = accuracy_score(y_test, y_pred)\n\nprint(\"==================================================\")\nprint(\"SUCCESS: Machine Learning Model 1 Successfully Trained!\")\nprint(\"==================================================\")\nprint(f\"Overall Model Accuracy: {accuracy * 100:.2f}%\")\nprint(\"\\n--- Detailed Classification Performance Report ---\")\nprint(classification_report(y_test, y_pred, target_names=['Mainstream Track (0)', 'Hidden Track (1)']))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T17:42:45.845092Z","iopub.execute_input":"2026-09-17T17:42:45.845403Z","iopub.status.idle":"2026-09-17T17:42:45.988009Z","shell.execute_reply.started":"2026-09-17T17:42:45.845378Z","shell.execute_reply":"2026-09-17T17:42:45.987216Z"}},"outputs":[{"name":"stdout","text":"==================================================\nSUCCESS: Machine Learning Model 1 Successfully Trained!\n==================================================\nOverall Model Accuracy: 100.00%\n\n--- Detailed Classification Performance Report ---\n                      precision    recall  f1-score   support\n\nMainstream Track (0)       1.00      1.00      1.00        57\n    Hidden Track (1)       1.00      1.00      1.00         3\n\n            accuracy                           1.00        60\n           macro avg       1.00      1.00      1.00        60\n        weighted avg       1.00      1.00      1.00        60\n\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"## Phase 5: Machine Learning Model 2 - NLP Album Era Classification\nIn this advanced phase, we build a Natural Language Processing (NLP) pipeline. The objective is to predict the exact chronological BTS Era based *purely* on the raw text of the song lyrics.\n\n### Process:\n1. **Text Vectorization:** Converting raw English lyrics into numerical feature matrices using TF-IDF (Term Frequency-Inverse Document Frequency) while removing standard stop words.\n2. **Data Splitting:** Allocating 80% for learning text patterns and 20% for testing.\n3. **Model Training:** Deploying a secondary Random Forest Classifier optimized for text matrices.\n4. **Performance Evaluation:** Measuring how accurately the AI identifies the artistic era from text alone.\n","metadata":{}},{"cell_type":"code","source":"import pandas as pd\nimport numpy as np\nimport re\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import classification_report, accuracy_score\n\n# ==============================================================================\n# SAFE DATA LOADING (Garantili Veri Yükleme - TypeError Çözümü)\n# ==============================================================================\nfound_file = '/kaggle/input/datasets/learnwithsrishti/bts-data-set-in-csv/lyrics-v6.csv'\n\n# encoding='latin1' kullanarak bozuk unicode karakter kilitlenmelerini kökten çözüyoruz\ndf = pd.read_csv(found_file, encoding='latin1')\ndf.columns = df.columns.str.lower() \n\n# Zaman ve Dönem özelliklerini tekrar inşa edelim\ndf['album_rd'] = pd.to_datetime(df['album_rd'])\ndf['year'] = df['album_rd'].dt.year\n\ndef track_bts_era(year):\n    if year <= 2015:\n        return 'Early Era (School & Youth)'\n    elif 2016 <= year <= 2018:\n        return 'Golden Era (Wings & Love Yourself)'\n    else:\n        return 'Global Era (Dynamite & Beyond)'\n\ndf['bts_era'] = df['year'].apply(track_bts_era)\n\n# Boş sözleri dolduralım\ndf['lyrics'] = df['lyrics'].fillna('')\n\n# ==============================================================================\n# STEP 1: TEXT VECTORIZATION VIA TF-IDF (WORDS TO NUMBERS)\n# ==============================================================================\ntfidf = TfidfVectorizer(stop_words='english', max_features=1500)\nX_nlp = tfidf.fit_transform(df['lyrics']).toarray()\ny_nlp = df['bts_era']\n\n# ==============================================================================\n# STEP 2: SPLITTING THE TEXT DATA\n# ==============================================================================\nX_train_nlp, X_test_nlp, y_train_nlp, y_test_nlp = train_test_split(\n    X_nlp, y_nlp, test_size=0.20, random_state=42, stratify=y_nlp\n)\n\n# ==============================================================================\n# STEP 3: MODEL TRAINING (THE TEXT DETECTIVE LEARNS)\n# ==============================================================================\nnlp_rf_model = RandomForestClassifier(n_estimators=100, random_state=42)\nnlp_rf_model.fit(X_train_nlp, y_train_nlp)\n\n# ==============================================================================\n# STEP 4: NLP FINAL EXAM & REPORTING\n# ==============================================================================\ny_pred_nlp = nlp_rf_model.predict(X_test_nlp)\nnlp_accuracy = accuracy_score(y_test_nlp, y_pred_nlp)\n\nprint(\"==================================================\")\nprint(\"SUCCESS: NLP Machine Learning Model 2 Trained Successfully!\")\nprint(\"==================================================\")\nprint(f\"Lyrical Text Prediction Accuracy: {nlp_accuracy * 100:.2f}%\")\nprint(\"\\n--- Detailed NLP Era Performance Report ---\")\nprint(classification_report(y_test_nlp, y_pred_nlp))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T17:42:45.989004Z","iopub.execute_input":"2026-09-17T17:42:45.989176Z","iopub.status.idle":"2026-09-17T17:42:46.299177Z","shell.execute_reply.started":"2026-09-17T17:42:45.989158Z","shell.execute_reply":"2026-09-17T17:42:46.298579Z"}},"outputs":[{"name":"stdout","text":"==================================================\nSUCCESS: NLP Machine Learning Model 2 Trained Successfully!\n==================================================\nLyrical Text Prediction Accuracy: 71.67%\n\n--- Detailed NLP Era Performance Report ---\n                                    precision    recall  f1-score   support\n\n        Early Era (School & Youth)       0.60      0.40      0.48        15\n