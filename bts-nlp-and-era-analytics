rd_importance_df = pd.DataFrame({\n    'Word': feature_names,\n    'Importance': importances\n}).sort_values(by='Importance', ascending=False).reset_index(drop=True)\n\n# ==============================================================================\n# STEP 2: GROUPING TOP KEYWORDS BY ERA TO MAP EMOTIONS (DATA AUDITING)\n# ==============================================================================\nprint(\"==================================================\")\n# Displaying the top 20 most powerful words that shaped the AI's predictions\nprint(\"TOP 20 CRITICAL KEYWORDS DIRECTING THE CLASSIFICATION MODEL:\")\nprint(\"==================================================\")\nprint(word_importance_df.head(20))\n\n# ==============================================================================\n# STEP 3: STATISTICAL VISUALIZATION OF THE TOP 15 SIGNATURE WORDS (BAR PLOT)\n# ==============================================================================\nplt.figure(figsize=(12, 5))\n\n# Plotting a horizontal bar chart for the top 15 most important linguistic markers\nsns.barplot(\n    data=word_importance_df.head(15), \n    x='Importance', \n    y='Word', \n    palette='magma' # Academic high-contrast color scheme\n)\n\nplt.title('Linguistic Drivers: Top 15 Words Defining Album Era Classification', fontsize=14, fontweight='bold', pad=15)\nplt.xlabel('Mathematical Feature Importance Score', fontsize=12)\nplt.ylabel('Lyrical Keyword (Feature Name)', fontsize=12)\nplt.grid(axis='x', linestyle='--', alpha=0.5)\nplt.tight_layout()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-17T17:42:46.299984Z","iopub.execute_input":"2026-09-17T17:42:46.30021Z","iopub.status.idle":"2026-09-17T17:42:46.662795Z","shell.execute_reply.started":"2026-09-17T17:42:46.300184Z","shell.execute_reply":"2026-09-17T17:42:46.662126Z"}},"outputs":[{"name":"stdout","text":"==================================================\nTOP 20 CRITICAL KEYWORDS DIRECTING THE CLASSIFI